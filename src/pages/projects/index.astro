---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Layout from '../../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const filters = ['All', 'Residential', 'Commercial', 'Interiors'] as const;
const title = pageTitle('Architecture & Interior Projects', site.name);
const description = clipMeta(
  'Browse residential, commercial, and interior projects by BXR Architect. Houses, workplaces, hospitality, and apartments.',
);
---

<Layout title={title} description={description}>
  <section class="page-wrap py-14 md:py-20">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Portfolio</p>
    <h1 class="mt-3 font-serif text-4xl font-medium md:text-6xl">Selected work</h1>
    <p class="mt-4 max-w-xl text-base font-light leading-relaxed text-muted">
      Houses, interiors, and commercial spaces. Each project is a brief, a constraint, and a finished room.
    </p>

    <div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects">
      {
        filters.map((filter) => (
          <button
            type="button"
            data-filter={filter}
            class="filter-btn h-10 border border-line px-4 text-[11px] uppercase tracking-[0.16em] text-muted aria-[pressed=true]:border-ink aria-[pressed=true]:bg-ink aria-[pressed=true]:text-paper"
            aria-pressed={filter === 'All' ? 'true' : 'false'}
          >
            {filter}
          </button>
        ))
      }
    </div>

    <div id="project-grid" class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p id="empty-filter" class="mt-12 hidden text-sm text-muted">No projects in this type yet.</p>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-typology]');
  const empty = document.getElementById('empty-filter');

  const apply = (filter: string) => {
    let visible = 0;
    cards.forEach((card) => {
      const show = filter === 'All' || card.dataset.typology === filter;
      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });
    empty?.classList.toggle('hidden', visible !== 0);
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.filter === filter));
    });
  };

  const fromHash = () => {
    const hash = window.location.hash.replace('#', '').toLowerCase();
    if (hash === 'residential') apply('Residential');
    else if (hash === 'commercial') apply('Commercial');
    else if (hash === 'interiors') apply('Interiors');
    else apply('All');
  };

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'All';
      const hash = filter === 'All' ? '' : `#${filter.toLowerCase()}`;
      history.replaceState(null, '', `${window.location.pathname}${hash}`);
      apply(filter);
    });
  });

  fromHash();
  window.addEventListener('hashchange', fromHash);
</script>
