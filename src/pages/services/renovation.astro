---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Renovation', site.name);
const description = clipMeta('Home, apartment, villa, and commercial renovation services in Chennai and Tamil Nadu from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/renovation.png"
  eyebrow="Reshape what exists"
  headline="Existing Spaces. New Possibilities."
  intro="We reveal the potential already inside dated or underperforming spaces, making them more useful, expressive, and alive."
  paragraphs={[
    'BXR Architect provides home, apartment, villa, and commercial renovation services in Chennai and Tamil Nadu through intelligent planning and carefully considered interventions.',
    'We rethink layouts, improve functionality, introduce natural light where possible, refresh materials and finishes, and redefine architectural character.',
    'We preserve what matters, improve what no longer serves, and create a contemporary language without losing the character of the original space.',
  ]}
  cards={[
    { icon: 'assess', title: 'Assess', text: 'Identify what should stay, what should change, and where the space can improve.' },
    { icon: 'redesign', title: 'Redesign', text: 'Rework layouts and flows around lifestyle, function, and future use.' },
    { icon: 'refine', title: 'Refine', text: 'Select materials, finishes, lighting, and details for a polished result.' },
    { icon: 'transform', title: 'Transform', text: 'Deliver a space aligned with the way it is meant to function and feel.' },
  ]}
  services="Home Renovation • Apartment Renovation • Villa Renovation • Commercial Renovation • Layout Redesign • Interior Remodeling • Façade Enhancement • Complete Property Transformation"
/>
