---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Renovation', site.name);
const description = clipMeta('Home, apartment, villa, and commercial renovation services in Chennai from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/renovation.png"
  eyebrow="Existing spaces · new possibilities"
  headline="Thoughtful transformation for places with a history."
  intro="We uncover the potential within existing spaces through intelligent planning, contemporary design, and carefully considered interventions."
  paragraphs={['We rethink layouts, improve functionality, introduce natural light where possible, refresh materials and finishes, and redefine architectural character.', 'The goal is not to replace everything, but to understand what deserves to remain and make the whole space work better.']}
  cards={[{ icon: 'assess', title: 'Assess', text: 'Understand what works and what can be improved.' }, { icon: 'redesign', title: 'Replan', text: 'Unlock better flow, function, and flexibility.' }, { icon: 'refine', title: 'Refine', text: 'Renew materials and details with restraint.' }, { icon: 'transform', title: 'Transform', text: 'Give the existing space a renewed identity.' }]}
  services="Home renovation · Apartment renovation · Villa renovation · Commercial renovation · Interior upgrades"
/>
