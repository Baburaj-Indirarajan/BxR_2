---
import { getCollection } from 'astro:content';
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const related = (await getCollection('projects'))
  .filter((project) => project.data.typology === 'Residential' || project.data.typology === 'Commercial')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const title = pageTitle('Architectural Design', site.name);
const description = clipMeta(
  'Architectural design by BXR Architect. New homes, extensions, and commercial shells — concept, drawings, and site review.',
);
---

<Layout title={title} description={description} image="photo-1600585154340-be6161a56a0c">
  <section class="page-wrap py-14 md:py-20">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Services</p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl font-medium md:text-6xl">Architectural design</h1>
    <p class="mt-5 max-w-2xl text-lg font-light leading-relaxed text-muted">
      We plan buildings around climate, plot, and how people will actually use the rooms. The drawing is a
      tool. The site is the test.
    </p>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2">
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">Houses and extensions</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Family houses, courtyards, and additions that respect what is already there.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">Commercial shells</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Workplaces, hospitality, and small public rooms with a clear arrival and a quiet plan.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">What you get</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Concept, developed drawings, consultant coordination, and reviews on site.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">Interiors, together</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          The studio also designs interiors, so the envelope and the room are not two different buildings.
        </p>
      </li>
    </ul>
  </section>

  <section class="border-t border-line py-14 md:py-20">
    <div class="page-wrap">
      <h2 class="font-serif text-3xl font-medium">Related projects</h2>
      <div class="mt-10 grid gap-10 sm:grid-cols-3">
        {
          related.map((project) => (
            <a href={`/projects/${project.id}`} class="group block">
              <Img
                id={project.data.cover}
                alt={`${project.data.title} — architectural project by BXR Architect`}
                sizes="(max-width: 640px) 100vw, 33vw"
                class="aspect-[4/5] w-full"
              />
              <h3 class="mt-4 font-serif text-2xl font-medium">{project.data.title}</h3>
              <p class="mt-1 text-sm text-muted">{project.data.typology}</p>
            </a>
          ))
        }
      </div>
      <a href="/projects#residential" class="mt-10 inline-block text-[12px] uppercase tracking-[0.16em] text-muted">
        All architecture projects
      </a>
    </div>
  </section>
</Layout>
