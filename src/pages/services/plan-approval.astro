---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Plan Approval', site.name);
const description = clipMeta('Professional building plan approval services in Chennai and surrounding areas from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/plan-approval.png"
  eyebrow="Clear process · compliant planning"
  headline="Confident beginnings for every project."
  intro="We prepare clear drawings and documentation that help clients move through the approval process with confidence."
  paragraphs={['From architectural drawings to required documentation and revisions, every submission is prepared with careful attention to applicable planning requirements.', 'Our structured approach reduces complexity, avoids unnecessary delays, and creates a clear path from proposal to approval.']}
  cards={[{ icon: 'approval', title: 'Documentation', text: 'Clear, coordinated drawings and submission material.' }, { icon: 'planning', title: 'Regulations', text: 'Design decisions aligned with planning requirements.' }, { icon: 'assess', title: 'Review', text: 'Careful checks before documentation is submitted.' }, { icon: 'quality', title: 'Confidence', text: 'A more predictable route from idea to approval.' }]}
  services="Building plan approval · Approval drawings · Planning documentation · Regulation compliance · Drawing revisions"
/>
