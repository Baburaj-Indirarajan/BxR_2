---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Plan Approval', site.name);
const description = clipMeta('Professional building plan approval services in Chennai and across Tamil Nadu from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/plan-approval.png"
  eyebrow="Clear approvals, smarter starts"
  headline="Clear Process. Compliant Planning. Confident Beginnings."
  intro="We help clients move from concept to compliance with a streamlined approval process, accurate documentation, and clear coordination."
  paragraphs={[
    'BXR Architect provides professional building plan approval services in Chennai and across Tamil Nadu, helping clients navigate planning requirements with clarity and confidence.',
    'From architectural drawings to documentation and revisions, every submission is developed with careful attention to applicable planning regulations and building requirements.',
    'Our structured approach minimizes complexity and unnecessary delays, creating a clear path from proposal to approval.',
  ]}
  cards={[
    { icon: 'planning', title: 'Drawings', text: 'Accurate, review-ready architectural plans tailored to local approval requirements.' },
    { icon: 'quality', title: 'Compliance', text: 'Guidance aligned with planning rules, setbacks, coverage, and building regulations.' },
    { icon: 'execution', title: 'Coordination', text: 'Documentation, revisions, and updates managed with clarity and control.' },
    { icon: 'approval', title: 'Submission', text: 'A clean, well-structured package that keeps your project moving.' },
  ]}
  services="Building Plan Approval • Approval Drawings • Planning Documentation • Building Regulation Compliance • Drawing Revisions • Approval Coordination"
/>
