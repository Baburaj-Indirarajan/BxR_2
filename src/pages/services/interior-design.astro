---
import { getCollection } from 'astro:content';
import Img from '../../components/Img.astro';
import Layout from '../../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const related = (await getCollection('projects'))
  .filter((project) => project.data.typology === 'Interiors')
  .sort((a, b) => a.data.order - b.data.order);

const title = pageTitle('Interior Design', site.name);
const description = clipMeta(
  'Interior design by BXR Architect. Apartments, villas, workplaces, and hospitality — layout, materials, furniture, and light.',
);
---

<Layout title={title} description={description} image="photo-1618221195710-dd6b41faaea6">
  <section class="page-wrap py-14 md:py-20">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Services</p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl font-medium md:text-6xl">Interior design</h1>
    <p class="mt-5 max-w-2xl text-lg font-light leading-relaxed text-muted">
      Rooms should work at 7 a.m. and at 9 p.m. We start with layout and storage, then materials and light —
      not a mood board first.
    </p>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2">
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">Homes</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Apartments and villas. Built-in storage, kitchens that face life, finishes that age.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">Work and hospitality</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Studios, cafes, and lobbies where the furniture is part of the plan, not leftover.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">What you get</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          Layout, material palette, furniture, lighting, and drawings the contractor can follow.
        </p>
      </li>
      <li class="border-t border-line pt-6">
        <h2 class="font-serif text-2xl font-medium">With architecture</h2>
        <p class="mt-2 text-sm font-light leading-relaxed text-muted">
          When we also do the building, interiors are not a second language. One studio, one set of details.
        </p>
      </li>
    </ul>
  </section>

  <section class="border-t border-line py-14 md:py-20">
    <div class="page-wrap">
      <h2 class="font-serif text-3xl font-medium">Related projects</h2>
      <div class="mt-10 grid gap-10 sm:grid-cols-2">
        {
          related.map((project) => (
            <a href={`/projects/${project.id}`} class="group block">
              <Img
                id={project.data.cover}
                alt={`${project.data.title} — interior design by BXR Architect`}
                sizes="(max-width: 640px) 100vw, 50vw"
                class="aspect-[4/5] w-full"
              />
              <h3 class="mt-4 font-serif text-2xl font-medium">{project.data.title}</h3>
              <p class="mt-1 text-sm text-muted">{project.data.excerpt}</p>
            </a>
          ))
        }
      </div>
      <a href="/projects#interiors" class="mt-10 inline-block text-[12px] uppercase tracking-[0.16em] text-muted">
        All interior projects
      </a>
    </div>
  </section>
</Layout>
