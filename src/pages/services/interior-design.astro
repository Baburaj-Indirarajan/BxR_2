---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Interior Design', site.name);
const description = clipMeta('Refined interior design services in Chennai and Tamil Nadu from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/interior-design.png"
  eyebrow="A softer luxury, made functional"
  headline="Refined Interiors. Designed for Living."
  intro="Sophisticated interiors shaped by simplicity, functionality, thoughtful detailing, and the way each space is actually lived in."
  paragraphs={[
    'BXR Architect creates residential, commercial, and bespoke interiors in Chennai and Tamil Nadu that feel cohesive, comfortable, and timeless.',
    'We compose layouts, materials, lighting, furniture, textures, and finishes as one considered language, creating rooms with warmth and clarity.',
    'Rather than following temporary trends, we design spaces with lasting character — environments that reflect the architecture, the people, and everyday life.',
  ]}
  cards={[
    { icon: 'planning', title: 'Planning', text: 'Thoughtful layouts that improve flow, storage, comfort, and everyday use.' },
    { icon: 'material', title: 'Materiality', text: 'Natural finishes, tactile surfaces, and tonal palettes selected for lasting warmth.' },
    { icon: 'interior', title: 'Lighting', text: 'Layered illumination designed to shape mood, depth, and experience.' },
    { icon: 'refine', title: 'Detail', text: 'Furniture, built-ins, and finishes that elevate without unnecessary excess.' },
  ]}
  services="Residential Interiors • Commercial Interiors • Space Planning • Material & Finish Selection • Lighting Design • Custom Furniture • 3D Interior Visualization"
/>
