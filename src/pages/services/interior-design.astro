---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Interior Design', site.name);
const description = clipMeta('Refined residential and commercial interior design services in Chennai from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/interior-design.png"
  eyebrow="Refined interiors · designed for living"
  headline="Rooms that feel complete, considered, and entirely yours."
  intro="We compose layouts, materials, lighting, furniture, textures, and finishes into cohesive interiors with enduring character."
  paragraphs={['Our interior design work covers residential, commercial, and bespoke spaces, always beginning with how the space needs to feel and function.', 'Rather than following temporary trends, we create environments that reflect the architecture, purpose, and individuality of the people who use them.']}
  cards={[{ icon: 'interior', title: 'Space planning', text: 'Layouts that make movement and living feel natural.' }, { icon: 'material', title: 'Materials', text: 'Tactile finishes selected for character and longevity.' }, { icon: 'concept', title: 'Lighting', text: 'Layered light that supports mood and function.' }, { icon: 'product', title: 'Furniture', text: 'Pieces and details composed as part of the whole.' }]}
  services="Residential interiors · Commercial interiors · Space planning · Material selection · Lighting design · Custom furniture"
/>
