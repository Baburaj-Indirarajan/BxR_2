---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Planning & Architectural Design', site.name);
const description = clipMeta('Planning and architectural design services in Chennai and Tamil Nadu from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/planning-architectural-design.png"
  eyebrow="Context-led design"
  headline="Purposeful Architecture. Timeless Design."
  intro="We turn complex requirements into refined, buildable spaces that feel distinctive, efficient, and connected to their context."
  paragraphs={[
    'Architecture begins with understanding — the site, the people, the purpose, and the possibilities.',
    'As an architecture and design studio in Chennai, we shape residential, commercial, and contemporary environments across Chennai and Tamil Nadu with a focus on function, proportion, light, ventilation, materiality, and clarity.',
    'From initial concepts and space planning to detailed design and visualization, we create architecture that is purposeful from the first sketch to the final detail.',
  ]}
  cards={[
    { icon: 'concept', title: 'Concept', text: 'Site understanding, user needs, and design direction shaped into a clear idea.' },
    { icon: 'planning', title: 'Planning', text: 'Efficient layouts, natural light, ventilation, and circulation mapped for everyday life.' },
    { icon: 'design', title: 'Design', text: 'Detailed architectural design balancing performance, aesthetics, and value.' },
    { icon: 'visualization', title: 'Visualization', text: 'Clear visual communication to refine decisions before construction begins.' },
  ]}
  services="Architectural Planning • Residential Design • Commercial Architecture • Space Planning • Floor Plans & Elevations • 3D Visualization • Design Development"
/>
