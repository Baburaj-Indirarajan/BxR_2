---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Planning & Architectural Design', site.name);
const description = clipMeta('Planning and architectural design services in Chennai and surrounding areas from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/planning-architectural-design.png"
  eyebrow="Purposeful architecture · timeless design"
  headline="Spaces shaped around people, place, and possibility."
  intro="We develop residential and commercial architecture through a considered balance of function, proportion, light, ventilation, and materiality."
  paragraphs={['Architecture begins with understanding the site, the people, the purpose, and the possibilities.', 'From initial concepts and space planning to detailed design and visualization, we create spaces that are refined, functional, and connected to their context.']}
  cards={[{ icon: 'architecture', title: 'Context', text: 'Design rooted in site, climate, and everyday life.' }, { icon: 'planning', title: 'Planning', text: 'Clear layouts that support how spaces are used.' }, { icon: 'concept', title: 'Concept', text: 'A strong idea carried through every decision.' }, { icon: 'visualization', title: 'Visualization', text: 'See the design clearly before it is built.' }]}
  services="Concept design · Space planning · Architectural design · 3D visualization · Working drawings"
/>
