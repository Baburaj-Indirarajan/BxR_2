---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Construction', site.name);
const description = clipMeta('Integrated construction services in Chennai and Tamil Nadu from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/construction.png"
  eyebrow="From drawings to delivery"
  headline="Designed with Vision. Built with Precision."
  intro="We transform design intent into robust, carefully executed reality through disciplined coordination and thoughtful site delivery."
  paragraphs={[
    'BXR Architect delivers integrated construction services in Chennai and across Tamil Nadu, connecting architecture and execution within one coordinated process.',
    'We coordinate structure, finishes, site activity, and workmanship with a focus on design goals, time, quality, and long-term performance.',
    'From site coordination to final detailing, our approach bridges the gap between architecture on paper and the experience of the finished space.',
  ]}
  cards={[
    { icon: 'site', title: 'Site', text: 'Structured oversight and coordination that keep execution aligned with the design.' },
    { icon: 'quality', title: 'Quality', text: 'Materials, finishes, and workmanship reviewed for consistency and durability.' },
    { icon: 'execution', title: 'Execution', text: 'A clear construction flow from detailing to handover, with better control.' },
    { icon: 'finish', title: 'Finish', text: 'Architectural refinement at every stage so the built result reflects the vision.' },
  ]}
  services="Residential Construction • Commercial Construction • Turnkey Execution • Site Coordination • Material Management • Quality Monitoring • Architectural Supervision • Finishing & Detailing"
/>
