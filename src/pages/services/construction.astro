---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Construction', site.name);
const description = clipMeta('Integrated construction services in Chennai and surrounding areas from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/construction.png"
  eyebrow="Designed with vision · built with precision"
  headline="A clear connection between drawing and built reality."
  intro="We support projects through construction with careful planning, coordination, quality control, and respect for design intent."
  paragraphs={['From structural development to architectural finishes, each stage is approached with attention to materials, workmanship, and detail.', 'By connecting architecture and construction within one coordinated process, we create greater consistency between what is envisioned and what is built.']}
  cards={[{ icon: 'execution', title: 'Coordination', text: 'Clear communication across every project stage.' }, { icon: 'quality', title: 'Quality', text: 'Workmanship and materials reviewed with care.' }, { icon: 'construction', title: 'Execution', text: 'Design intent carried through the site process.' }, { icon: 'site', title: 'Site support', text: 'Practical decisions where drawings meet reality.' }]}
  services="Construction coordination · Site reviews · Material oversight · Finish detailing · Execution support"
/>
