---
import ServicePage from '../../components/ServicePage.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Product Design', site.name);
const description = clipMeta('Bespoke product and furniture design in Chennai from BXR Architect.');
---

<ServicePage
  title={title}
  description={description}
  image="/product-design.png"
  eyebrow="Objects with purpose · details with character"
  headline="The same care for the objects that complete a space."
  intro="We design custom furniture, built-in elements, fixtures, and architectural details that belong naturally within their environment."
  paragraphs={['Every product is developed through an exploration of proportion, function, material, craftsmanship, and detail.', 'The result is design with its own identity, refined enough to sit naturally within the architecture and interiors around it.']}
  cards={[{ icon: 'product', title: 'Furniture', text: 'Custom pieces developed for the way spaces are used.' }, { icon: 'material', title: 'Material', text: 'Honest material choices with tactile presence.' }, { icon: 'form', title: 'Form', text: 'Proportion and silhouette considered from every angle.' }, { icon: 'realization', title: 'Realization', text: 'Design details resolved for making and use.' }]}
  services="Furniture design · Built-in elements · Custom fixtures · Architectural features · Product visualization"
/>
