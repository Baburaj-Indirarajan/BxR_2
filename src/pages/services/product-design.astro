---
import Layout from '../../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../../lib/seo';
import { site } from '../../lib/site';

const title = pageTitle('Product Design', site.name);
const description = clipMeta(
  'Bespoke product and furniture design in Chennai from BXR Architect.',
);
---

<Layout title={title} description={description}>
  <section class="page-wrap py-14 md:py-20">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Services</p>
    <h1 class="mt-3 max-w-3xl font-serif text-4xl font-medium md:text-6xl">Product design</h1>

    <div class="mt-10 max-w-3xl space-y-6 text-lg font-light leading-relaxed text-muted">
      <h2 class="font-serif text-3xl font-medium text-ink md:text-4xl">Objects with Purpose. Details with Character.</h2>
      <p>
        Architecture extends beyond walls and spaces. It lives in the objects, furniture, materials, and details we
        interact with every day.
      </p>
      <p>
        BXR Architect offers <strong class="font-medium text-ink">bespoke product and furniture design in Chennai</strong>,
        creating custom pieces that complement architectural and interior environments.
      </p>
      <p>
        From furniture and built-in elements to architectural features and custom fixtures, every product is developed
        through an exploration of proportion, function, material, craftsmanship, and detail.
      </p>
      <p>
        The result is design that feels intentional — distinctive enough to have its own identity, yet refined enough
        to belong naturally within the space.
      </p>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <p class="text-sm font-medium leading-relaxed text-ink">
        <span class="text-brass">Services:</span> Bespoke Furniture • Custom Fixtures • Architectural Elements •
        Product Development • Material Exploration • Custom Design Solutions
      </p>
    </div>
  </section>
</Layout>
