---
import Layout from '../layouts/Layout.astro';
import { pageTitle } from '../lib/seo';
import { site } from '../lib/site';

const title = pageTitle('Page not found', site.name);
---

<Layout title={title} description="This page is not on the BXR Architect site." noindex>
  <section class="page-wrap py-24 md:py-36">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">404</p>
    <h1 class="mt-3 font-serif text-4xl font-medium md:text-6xl">Page not found</h1>
    <p class="mt-4 max-w-md font-light text-muted">
      That URL is not a project or a page. Return home or browse the work.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="inline-flex h-12 items-center justify-center bg-ink px-6 text-[12px] uppercase tracking-[0.18em] text-paper">
        Home
      </a>
      <a href="/projects" class="inline-flex h-12 items-center justify-center border border-ink px-6 text-[12px] uppercase tracking-[0.18em] text-ink">
        Projects
      </a>
    </div>
  </section>
</Layout>
