---
import { getCollection } from 'astro:content';
import Img from '../components/Img.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Layout from '../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../lib/seo';
import { processSteps, site } from '../lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const services = [
  {
    icon: 'approval',
    title: 'Plan approval',
    href: '/services/plan-approval',
    text: 'Clear guidance and documentation to help move your project through the approval process.',
  },
  {
    icon: 'architecture',
    title: 'Planning & Architectural Design',
    href: '/services/planning-architectural-design',
    text: 'Thoughtful plans and practical designs shaped around how you want to live or work.',
  },
  {
    icon: 'interior',
    title: 'Interior Design',
    href: '/services/interior-design',
    text: 'Coordinated layouts, materials, furniture, and lighting for rooms that feel complete.',
  },
  {
    icon: 'construction',
    title: 'Construction',
    href: '/services/construction',
    text: 'Reliable support from drawings to site, keeping the design clear through construction.',
  },
  {
    icon: 'renovation',
    title: 'Renovation',
    href: '/services/renovation',
    text: 'Sensitive updates that improve existing spaces while respecting what already works.',
  },
  {
    icon: 'product',
    title: 'Product Design',
    href: '/services/product-design',
    text: 'Considered objects and details that bring the same care and clarity to everyday use.',
  },
] as const;
const title = pageTitle('', site.name, site.tagline);
const description = clipMeta(site.description);
---

<Layout title={title} description={description} image="photo-1600585154340-be6161a56a0c">
  <section class="relative min-h-[100svh]">
    <Img
      id="photo-1600585154340-be6161a56a0c"
      alt="Placeholder: a contemporary house with a calm, linear facade — BXR Architect"
      sizes="100vw"
      priority
      class="absolute inset-0 h-full w-full"
      width={1920}
      height={1280}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-night/80 via-night/25 to-night/10"></div>
    <div class="page-wrap relative flex min-h-[100svh] flex-col justify-end pb-16 pt-28 md:pb-24">
      <p class="text-[11px] uppercase tracking-[0.28em] text-paper/80">Architecture · Interiors</p>
      <h1 class="mt-4 max-w-4xl font-serif text-[2.6rem] font-medium leading-[1.05] text-paper sm:text-6xl lg:text-7xl">
        Architecture and interiors — space, soul, story
      </h1>
      <p class="mt-6 max-w-xl text-base font-light text-paper/85 md:text-lg">
        BXR Architect is a team studio. We design buildings and rooms that hold how people live.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/projects"
          class="inline-flex h-12 items-center justify-center bg-paper px-6 text-[12px] uppercase tracking-[0.18em] text-ink"
        >
          View work
        </a>
        <a
          href="/contact"
          class="inline-flex h-12 items-center justify-center border border-paper/50 px-6 text-[12px] uppercase tracking-[0.18em] text-paper"
        >
          Start a project
        </a>
      </div>
    </div>
  </section>

  <section class="page-wrap grid gap-10 py-16 md:grid-cols-[1.1fr_0.9fr] md:gap-20 md:py-28">
    <div>
      <p class="text-[11px] uppercase tracking-[0.22em] text-brass">About Us</p>
      <h2 class="mt-3 font-serif text-4xl font-medium md:text-5xl">Architecture shaped by experience</h2>
    </div>
    <div class="space-y-5 text-[17px] font-light leading-relaxed text-muted">
      <p>
        BXR Architect is a design practice shaped by the belief that architecture is more than the making of
        buildings — it is the making of experiences.
      </p>
      <p>
        We work across architecture, interiors, and the built environment, creating spaces that respond to
        context, purpose, and the people who inhabit them.
      </p>
      <p>
        <a href="/about" class="text-ink underline decoration-brass underline-offset-4 hover:text-brass">
          Discover the studio
        </a>
      </p>
    </div>
  </section>

  <section class="page-wrap py-16 md:py-24">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div>
        <a href="/services" class="group inline-block">
          <p class="text-[11px] uppercase tracking-[0.22em] text-brass">What we do</p>
          <h2 class="mt-2 font-serif text-4xl font-medium transition-colors group-hover:text-brass md:text-5xl">
            Services
          </h2>
        </a>
      </div>
      <a href="/services" class="text-[12px] uppercase tracking-[0.16em] text-muted hover:text-ink">
        Explore all services
      </a>
    </div>
    <div class="mt-10 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <a href={service.href} class="group bg-paper p-7 transition hover:bg-ink/[0.02] md:p-9">
            <span class="inline-flex text-brass">
              <ServiceIcon name={service.icon} size={28} />
            </span>
            <h3 class="mt-4 font-serif text-2xl font-medium group-hover:text-brass">{service.title}</h3>
            <p class="mt-3 text-sm font-light leading-relaxed text-muted">{service.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-line py-16 md:py-24">
    <div class="page-wrap">
      <div class="mb-10 flex items-end justify-between gap-4">
        <div>
          <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Selected work</p>
          <h2 class="mt-2 font-serif text-4xl font-medium md:text-5xl">Projects</h2>
        </div>
        <a href="/projects" class="hidden text-[12px] uppercase tracking-[0.16em] text-muted hover:text-ink md:inline">
          All projects
        </a>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <a href={`/projects/${project.id}`} class="group block">
              <div class="overflow-hidden">
                <Img
                  id={project.data.cover}
                  alt={`${project.data.title} — ${project.data.typology}, ${project.data.location}`}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  class="aspect-[4/5] w-full transition duration-700 group-hover:scale-[1.03]"
                />
              </div>
              <h3 class="mt-4 font-serif text-2xl font-medium">{project.data.title}</h3>
              <p class="mt-1 text-sm text-muted">
                {project.data.typology}
                <span class="mx-2 text-brass">·</span>
                {project.data.year}
              </p>
            </a>
          ))
        }
      </div>
      <a
        href="/projects"
        class="mt-10 inline-flex md:hidden text-[12px] uppercase tracking-[0.16em] text-muted"
      >
        All projects
      </a>
    </div>
  </section>

  <section class="bg-ink text-paper">
    <div class="page-wrap py-16 md:py-24">
      <p class="text-[11px] uppercase tracking-[0.22em] text-brass-light">How we work</p>
      <h2 class="mt-2 font-serif text-4xl font-medium md:text-5xl">Process</h2>
      <ol class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step) => (
            <li>
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-brass-light/40 text-brass-light">
                <ServiceIcon name={step.icon} size={22} />
              </span>
              <h3 class="mt-3 font-serif text-2xl font-medium">{step.title}</h3>
              <p class="mt-2 text-sm font-light leading-relaxed text-paper/70">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="page-wrap py-20 text-center md:py-28">
    <h2 class="font-serif text-4xl font-medium md:text-6xl">Start a project</h2>
    <p class="mx-auto mt-4 max-w-md font-light text-muted">
      Send a brief — plot, programme, timeline. We reply with next steps.
    </p>
    <a
      href="/contact"
      class="mt-8 inline-flex h-12 items-center justify-center bg-ink px-8 text-[12px] uppercase tracking-[0.18em] text-paper"
    >
      Contact the studio
    </a>
  </section>
</Layout>
