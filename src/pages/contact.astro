---
import Layout from '../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../lib/seo';
import { serviceAreas, site } from '../lib/site';

const sent = Astro.url.searchParams.get('sent') === '1';
const thanks = new URL('/contact?sent=1', Astro.url.origin).href;
const title = pageTitle('Contact', site.name);
const description = clipMeta(
  `Contact BXR Architect. Email ${site.email} or call ${site.phoneDisplay}. Send a project enquiry.`,
);
---

<Layout title={title} description={description}>
  <section class="page-wrap py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_0.72fr] lg:items-end">
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Start a conversation</p>
        <h1 class="mt-3 max-w-3xl font-serif text-5xl font-medium tracking-tight md:text-7xl">
          Let’s shape a place with purpose.
        </h1>
      </div>
      <p class="max-w-md text-lg font-light leading-relaxed text-muted lg:pb-2">
        Tell us what you are imagining. From the first brief to the final detail, we bring clarity, care, and
        character to every project.
      </p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="border border-line bg-white/60 p-6 md:p-10">
        {
          sent ? (
            <p class="border border-line bg-ink/[0.03] px-6 py-8 font-light text-ink" role="status">
              Thank you. Your enquiry was sent. We will reply to the email you gave.
            </p>
          ) : (
            <form
              action={`https://formsubmit.co/${site.email}`}
              method="POST"
              class="space-y-5"
            >
              {/* Public enquiry form. Do not log request or response bodies — they may contain PII. */}
              <input type="hidden" name="_subject" value="BXR Architect — project enquiry" />
              <input type="hidden" name="_next" value={thanks} />
              <input type="hidden" name="_template" value="table" />
              <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Name</span>
                <input
                  required
                  name="name"
                  type="text"
                  autocomplete="name"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Email</span>
                <input
                  required
                  name="email"
                  type="email"
                  autocomplete="email"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Phone</span>
                <input
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Message</span>
                <textarea
                  required
                  name="message"
                  rows="5"
                  class="mt-2 w-full border border-line bg-transparent px-3 py-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <button
                type="submit"
                class="inline-flex h-12 items-center justify-center bg-ink px-8 text-[12px] uppercase tracking-[0.18em] text-paper"
              >
                Send enquiry
              </button>
            </form>
          )
        }
      </div>

      <aside class="flex flex-col justify-between bg-ink p-7 text-paper md:p-10">
        <div>
          <p class="text-[11px] uppercase tracking-[0.2em] text-brass-light">BXR Architect</p>
          <h2 class="mt-4 font-serif text-3xl font-medium md:text-4xl">Good spaces begin with a good brief.</h2>
          <p class="mt-5 max-w-sm text-sm font-light leading-relaxed text-paper/70">
            Share your site, programme, timeline, or simply the feeling you want to create. We will get back to
            you with a clear next step.
          </p>
        </div>
        <ul class="mt-12 space-y-4 border-t border-paper/20 pt-6 text-sm font-light">
          <li>
            <span class="block text-[10px] uppercase tracking-[0.18em] text-brass-light">Email</span>
            <a href={`mailto:${site.email}`} class="mt-1 inline-block hover:text-brass-light">{site.email}</a>
          </li>
          <li>
            <span class="block text-[10px] uppercase tracking-[0.18em] text-brass-light">Call</span>
            <a href={`tel:${site.telephone}`} class="mt-1 inline-block hover:text-brass-light">{site.phoneDisplay}</a>
          </li>
          <li>
            <span class="block text-[10px] uppercase tracking-[0.18em] text-brass-light">Message</span>
            <a href={site.whatsappUrl} class="mt-1 inline-block hover:text-brass-light">WhatsApp</a>
          </li>
        </ul>
      </aside>
    </div>
  </section>
  <section class="border-t border-line bg-ink/[0.03] py-12 md:py-16">
    <div class="page-wrap">
      <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Where we work</p>
      <h2 class="mt-3 font-serif text-3xl font-medium md:text-4xl">Architecture and interiors across Chennai</h2>
      <p class="mt-3 max-w-2xl text-sm font-light leading-relaxed text-muted">
        BXR Architect works with homeowners, businesses, and developers across Chennai and its surrounding
        neighbourhoods.
      </p>
      <div class="mt-7 flex flex-wrap gap-2">
        {serviceAreas.map((area) => (
          <span class="border border-line bg-paper px-3 py-1.5 text-xs text-muted">{area}</span>
        ))}
      </div>
    </div>
  </section>
</Layout>
