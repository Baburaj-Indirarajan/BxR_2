---
import Layout from '../layouts/Layout.astro';
import { clipMeta, pageTitle } from '../lib/seo';
import { site } from '../lib/site';

const sent = Astro.url.searchParams.get('sent') === '1';
const thanks = new URL('/contact?sent=1', Astro.url.origin).href;
const title = pageTitle('Contact', site.name);
const description = clipMeta(
  `Contact BXR Architect. Email ${site.email} or call ${site.phoneDisplay}. Send a project enquiry.`,
);
---

<Layout title={title} description={description}>
  <section class="page-wrap py-14 md:py-20">
    <p class="text-[11px] uppercase tracking-[0.22em] text-brass">Contact</p>
    <h1 class="mt-3 font-serif text-4xl font-medium md:text-6xl">Start a project</h1>
    <p class="mt-4 max-w-xl text-lg font-light leading-relaxed text-muted">
      Send a brief. Plot, programme, timeline. We reply with next steps.
    </p>

    <div class="mt-12 grid gap-14 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        {
          sent ? (
            <p class="border border-line bg-ink/[0.03] px-6 py-8 font-light text-ink" role="status">
              Thank you. Your enquiry was sent. We will reply to the email you gave.
            </p>
          ) : (
            <form
              action={`https://formsubmit.co/${site.email}`}
              method="POST"
              class="space-y-5"
            >
              {/* Public enquiry form. Do not log request or response bodies — they may contain PII. */}
              <input type="hidden" name="_subject" value="BXR Architect — project enquiry" />
              <input type="hidden" name="_next" value={thanks} />
              <input type="hidden" name="_template" value="table" />
              <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Name</span>
                <input
                  required
                  name="name"
                  type="text"
                  autocomplete="name"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Email</span>
                <input
                  required
                  name="email"
                  type="email"
                  autocomplete="email"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Phone</span>
                <input
                  name="phone"
                  type="tel"
                  autocomplete="tel"
                  class="mt-2 h-12 w-full border border-line bg-transparent px-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Project type</span>
                <select
                  name="project_type"
                  class="mt-2 h-12 w-full border border-line bg-paper px-3 text-ink outline-none focus:border-ink"
                >
                  <option>Architecture</option>
                  <option>Interior design</option>
                  <option>Both</option>
                  <option>Consultancy</option>
                </select>
              </label>
              <label class="block">
                <span class="text-[11px] uppercase tracking-[0.16em] text-muted">Message</span>
                <textarea
                  required
                  name="message"
                  rows="5"
                  class="mt-2 w-full border border-line bg-transparent px-3 py-3 text-ink outline-none focus:border-ink"
                />
              </label>
              <button
                type="submit"
                class="inline-flex h-12 items-center justify-center bg-ink px-8 text-[12px] uppercase tracking-[0.18em] text-paper"
              >
                Send enquiry
              </button>
            </form>
          )
        }
      </div>

      <aside class="lg:pl-6">
        <h2 class="text-[11px] uppercase tracking-[0.2em] text-brass">Studio</h2>
        <ul class="mt-5 space-y-3 text-base font-light">
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-brass">{site.email}</a>
          </li>
          <li>
            <a href={`tel:${site.telephone}`} class="hover:text-brass">{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={site.whatsappUrl} class="hover:text-brass">WhatsApp</a>
          </li>
        </ul>
        <p class="mt-8 max-w-sm text-sm font-light leading-relaxed text-muted">
          {site.name}. {site.tagline}. First FormSubmit delivery asks you to confirm the inbox.
        </p>
      </aside>
    </div>
  </section>
</Layout>
