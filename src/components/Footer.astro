---
import { nav, site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-night text-paper">
  <div class="page-wrap py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <p class="font-serif text-3xl font-medium">BXR Architect</p>
        <p class="mt-3 max-w-xs text-sm italic text-paper/70">{site.tagline}</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-brass-light">Studio</p>
        <ul class="mt-4 space-y-2 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-paper/80 hover:text-paper">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-[0.2em] text-brass-light">Contact</p>
        <ul class="mt-4 space-y-2 text-sm text-paper/80">
          <li>
            <a href={`mailto:${site.email}`} class="hover:text-paper">{site.email}</a>
          </li>
          <li>
            <a href={`tel:${site.telephone}`} class="hover:text-paper">{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={site.whatsappUrl} class="hover:text-paper">WhatsApp</a>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-14 text-xs text-paper/40">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
