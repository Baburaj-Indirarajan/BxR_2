---
import { photo, srcset } from '../lib/images';

interface Props {
  id: string;
  alt: string;
  sizes: string;
  class?: string;
  priority?: boolean;
  width?: number;
  height?: number;
}

const {
  id,
  alt,
  sizes,
  class: className = '',
  priority = false,
  width = 1600,
  height = 2000,
} = Astro.props;
---

<img
  src={photo(id, 1200)}
  srcset={srcset(id)}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={['bg-ink/5 object-cover', className]}
/>
