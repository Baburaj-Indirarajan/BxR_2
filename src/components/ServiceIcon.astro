---
interface Props {
  name: string;
  size?: number;
}

const { name, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'approval' && <><path d="M5 3.5h10l4 4V20.5H5z" /><path d="M15 3.5v4h4M8 12h8M8 16h5" /><path d="m8 8 1 1 2-2" /></>}
  {name === 'architecture' && <><path d="m3 11 9-7 9 7" /><path d="M5 10v9h14v-9M8 19v-5h3v5M16 12h1" /></>}
  {name === 'interior' && <><path d="M4 11v7M20 11v7M4 14h16M6 11V8h5a3 3 0 0 1 3 3M14 11V9h4a2 2 0 0 1 2 2" /><path d="M3 18h18" /></>}
  {name === 'construction' && <><path d="m3 20 6-6M7 20h4M15 4l5 5M13 6l5 5M4 13l7 7M3 17l4 4" /></>}
  {name === 'renovation' && <><path d="m14 4 6 6M13 5l6 6M4 20l7-7M3 21l4-1 12-12-3-3L4 17z" /><path d="m15 3 3-1 4 4-1 3" /></>}
  {name === 'product' && <><path d="M4 7h16v13H4zM7 7V4h10v3M8 12h8M8 16h5" /></>}
  {name === 'concept' && <><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1" /></>}
  {name === 'planning' && <><path d="M4 5h16v14H4zM8 3v4M16 3v4M4 9h16M8 13h3M8 16h6" /></>}
  {name === 'design' && <><path d="m4 20 4-1 10-10-3-3L5 16zM13 5l3-3 3 3-3 3M4 20h16" /></>}
  {name === 'visualization' && <><path d="M3 12s3-6 9-6 9 6 9 6-3 6-9 6-9-6-9-6z" /><circle cx="12" cy="12" r="2.5" /></>}
  {name === 'site' && <><path d="M4 20V8l8-5 8 5v12M8 20v-5h8v5M3 20h18" /></>}
  {name === 'quality' && <><path d="m12 3 7 3v5c0 4.5-3 7.5-7 10-4-2.5-7-5.5-7-10V6z" /><path d="m8 12 2.5 2.5L16 9" /></>}
  {name === 'execution' && <><path d="M5 19 19 5M13 5h6v6M5 13v6h6" /></>}
  {name === 'finish' && <><path d="M4 20h16M6 16h12M8 12h8M10 8h4M12 4v4" /></>}
  {name === 'assess' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5M8 10.5h5M10.5 8v5" /></>}
  {name === 'redesign' && <><path d="M4 7h12a4 4 0 1 1-4 4H5" /><path d="m7 4-3 3 3 3M20 17H8a4 4 0 1 1 4-4h7" /><path d="m17 14 3 3-3 3" /></>}
  {name === 'refine' && <><path d="M4 20 20 4M7 4h4M4 7v4M13 20h4M20 13v4" /><path d="m14 10 4-4" /></>}
  {name === 'transform' && <><path d="M4 12h16M12 4v16M5 5l14 14M19 5 5 19" /><circle cx="12" cy="12" r="9" /></>}
  {name === 'form' && <><path d="M5 19 7 5l10-2 2 14zM7 5l5 7 5-9M5 19h14" /></>}
  {name === 'material' && <><path d="m4 17 6-10 10 6-6 8z" /><path d="m8 15 4-5M13 18l4-6" /></>}
  {name === 'realization' && <><path d="M4 18h16M6 18V8l6-4 6 4v10M9 18v-5h6v5" /></>}
</svg>
